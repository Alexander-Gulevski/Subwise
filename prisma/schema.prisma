// Схема данных Subwise.
// Источник истины — docs/03-data-model.md. Изменения вносятся в оба файла.
//
// Незыблемые правила:
//   • деньги — только Int в минорных единицах (ADR-0004). Float запрещён
//   • даты — DateTime в UTC, часовой пояс применяется при отображении
//   • пользовательские данные удаляются мягко (deletedAt)
//   • каждая пользовательская таблица имеет userId с индексом

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
//  Пользователь и доступ
// ─────────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  plan      Plan      @default(free)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Запрос на удаление. Полное стирание — не позднее 30 дней (FR-12)
  deletedAt DateTime?

  identities    AuthIdentity[]
  subscriptions Subscription[]
  settings      UserSettings?
  reminderRules ReminderRule[]
  deliveries    NotificationDelivery[]
  importConns   ImportConnection[]
  sessions      Session[]
  categories    Category[]

  @@index([deletedAt])
}

enum Plan {
  free
  pro
}

/// Способ входа. Один User может иметь несколько — это позволяет
/// войти через Telegram и через email в один и тот же аккаунт (FR-09).
/// Поля пароля здесь нет и быть не может (ADR-0003).
model AuthIdentity {
  id         String       @id @default(cuid())
  userId     String
  provider   AuthProvider
  /// telegram id либо нормализованный (lowercase, trim) email
  externalId String
  verifiedAt DateTime?
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
}

enum AuthProvider {
  telegram
  email_otp
  yandex // зарезервировано, в MVP не активен
  vk // зарезервировано, в MVP не активен
}

model Session {
  id String @id @default(cuid())

  userId String
  /// SHA-256 хеш токена, не сам токен: утечка дампа не даёт войти
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Одноразовые коды входа. Хранится ХЕШ кода (docs/06, T3).
model EmailOtp {
  id String @id @default(cuid())

  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  /// ISO 4217. Валюта отображения итогов
  baseCurrency String @default("RUB")
  locale       String @default("ru")
  timezone     String @default("Europe/Moscow")

  /// Тихие часы в локальном времени пользователя, 0–23 (FR-06)
  quietHoursStart Int @default(22)
  quietHoursEnd   Int @default(9)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────
//  Каталог сервисов — общий справочник
// ─────────────────────────────────────────────────────────

model Service {
  id String @id @default(cuid())

  /// Устойчивый идентификатор в SEO-URL. Менять нельзя — сломает индексацию
  slug String @unique
  name String
  /// Синонимы для поиска с опечатками и латиницей (FR-04)
  aliases    String[]
  logoUrl    String?
  websiteUrl String?
  categoryId String?
  isActive   Boolean  @default(true)

  category      Category?          @relation(fields: [categoryId], references: [id])
  plans         ServicePlan[]
  guide         CancellationGuide?
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

/// Известные тарифы сервиса — для автозаполнения при добавлении (FR-01)
model ServicePlan {
  id        String @id @default(cuid())
  serviceId String

  name String
  /// 39900 = 399,00 ₽
  amountMinor Int
  currency    String
  period      BillingPeriod
  /// только для period = custom
  periodDays  Int?
  isDefault   Boolean       @default(false)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

/// Гид отмены. checkedAt критичен: гиды устаревают, старше 180 дней
/// помечаются как требующие проверки (FR-04).
model CancellationGuide {
  id        String @id @default(cuid())
  serviceId String @unique

  /// [{ order, title, description, imageUrl? }]
  steps Json
  /// Прямая ссылка в раздел управления подпиской, не на главную
  deepLink String?
  /// Например: «Доступ сохранится до конца оплаченного периода»
  warnings String[]
  /// Дата ФАКТИЧЕСКОЙ проверки инструкции
  checkedAt   DateTime
  /// Сколько раз пользователи сообщили, что инструкция не сработала
  reportCount Int      @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checkedAt])
}

model Category {
  id   String  @id @default(cuid())
  slug String  @unique
  name String
  icon String?

  /// false = создана пользователем
  isSystem Boolean @default(true)
  userId   String?

  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  services      Service[]
  subscriptions Subscription[]

  @@index([userId])
}

// ─────────────────────────────────────────────────────────
//  Подписки
// ─────────────────────────────────────────────────────────

model Subscription {
  id     String @id @default(cuid())
  userId String

  /// null, если пользователь ввёл сервис вручную
  serviceId  String?
  /// обязателен, когда serviceId = null
  customName String?
  categoryId String?

  /// ВСЕГДА минорные единицы. Float запрещён (ADR-0004)
  amountMinor Int
  /// Исходная валюта. НЕ меняется при пересчётах
  currency    String
  period      BillingPeriod
  /// только для period = custom
  periodDays  Int?

  status SubscriptionStatus @default(active)
  /// null для cancelled и expired
  nextBillingAt DateTime?

  /// Якорь расписания: исходная дата списания, задающая день месяца.
  /// НЕ меняется при наступлении списаний — иначе подписка от 31 числа
  /// «сползёт» на 28 после первого февраля и там останется.
  /// Меняется только когда пользователь явно правит дату (FR-01).
  billingAnchorAt DateTime

  /// заполнен только при status = trial (FR-05)
  trialEndsAt DateTime?
  /// до какой даты сохраняется доступ после отмены
  accessUntil DateTime?
  cancelledAt DateTime?

  /// Метка «Тинькофф •4321». НОМЕРА КАРТ НЕ ХРАНИМ
  paymentLabel String?
  note         String? @db.VarChar(500)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Мягкое удаление, 30 дней на восстановление (FR-01)
  deletedAt DateTime?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  service           Service?           @relation(fields: [serviceId], references: [id])
  category          Category?          @relation(fields: [categoryId], references: [id])
  billingEvents     BillingEvent[]
  cancellationFlows CancellationFlow[]

  @@index([userId, status])
  @@index([userId, deletedAt])
  /// Главный индекс планировщика — самый частый запрос в системе
  @@index([nextBillingAt])
  @@index([trialEndsAt])
}

enum SubscriptionStatus {
  active
  trial
  paused
  cancelled
  expired
}

enum BillingPeriod {
  weekly
  monthly
  quarterly
  semiannual
  yearly
  custom
}

/// Событие списания: прошлое (подтверждённое) или будущее (прогноз).
/// Основа и для напоминаний, и для аналитики.
model BillingEvent {
  id             String @id @default(cuid())
  subscriptionId String

  dueAt DateTime
  /// Фиксируется на момент события: цена подписки могла измениться
  amountMinor Int
  currency    String

  status BillingEventStatus @default(scheduled)
  /// когда пользователь подтвердил факт списания
  confirmedAt DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Защита от дублей при пересчёте расписания
  @@unique([subscriptionId, dueAt])
  @@index([dueAt, status])
}

enum BillingEventStatus {
  scheduled
  confirmed
  skipped
}

/// Попытка отмены. Создаётся CancellationProvider.start(),
/// закрывается confirm(). ЕДИНСТВЕННЫЙ путь в статус cancelled (ADR-0002).
model CancellationFlow {
  id             String @id @default(cuid())
  subscriptionId String

  /// 'guide' | 'virtual-card' | 'automated'
  providerKind String

  startedAt   DateTime             @default(now())
  outcome     CancellationOutcome?
  confirmedAt DateTime?
  note        String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

enum CancellationOutcome {
  succeeded
  failed
  postponed
  guide_outdated
}

// ─────────────────────────────────────────────────────────
//  Уведомления
// ─────────────────────────────────────────────────────────

model ReminderRule {
  id     String @id @default(cuid())
  userId String

  type NotificationType
  /// за сколько дней до события
  offsetDays Int
  channels   NotificationChannelId[]
  isEnabled  Boolean                @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, offsetDays])
  @@index([userId])
}

enum NotificationType {
  upcoming_charge
  trial_ending
  guide_outdated
  weekly_digest
}

enum NotificationChannelId {
  inapp
  telegram
  webpush
  email
}

/// Журнал доставок. dedupeKey обеспечивает идемпотентность
/// планировщика (NFR-05): повторный запуск не создаст второе сообщение.
model NotificationDelivery {
  id     String @id @default(cuid())
  userId String

  /// hash(eventId, ruleId, channelId)
  dedupeKey String                @unique
  type      NotificationType
  channel   NotificationChannelId

  status DeliveryStatus @default(pending)
  sentAt DateTime?
  /// используется только для inapp
  readAt DateTime?
  error  String?
  /// тело сообщения для истории in-app ленты
  payload Json

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

enum DeliveryStatus {
  pending
  sent
  failed
  /// попало в тихие часы, отложено
  deferred
}

model WebPushSubscription {
  id     String @id @default(cuid())
  userId String

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────
//  Импорт — расширенный тариф
// ─────────────────────────────────────────────────────────

model ImportConnection {
  id     String @id @default(cuid())
  userId String

  source ImportSourceId
  status ConnectionStatus @default(active)

  /// Токены доступа. ШИФРУЮТСЯ AES-256-GCM перед записью (NFR-03).
  /// Ключ живёт в ENCRYPTION_KEY, никогда в БД.
  credentialsEnc String?
  lastScanAt     DateTime?
  /// когда пользователь дал явное согласие на этот источник
  consentAt      DateTime
  revokedAt      DateTime?

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidates ImportCandidate[]

  createdAt DateTime @default(now())

  @@index([userId, source])
}

enum ImportSourceId {
  csv
  email
  bank
}

enum ConnectionStatus {
  active
  expired
  revoked
  error
}

/// Кандидат на подписку. НИКОГДА не превращается в Subscription
/// автоматически — только после подтверждения пользователем (FR-10).
model ImportCandidate {
  id           String @id @default(cuid())
  connectionId String

  /// как выглядело в источнике: "YM*PLUS 399.00"
  rawLabel    String
  amountMinor Int
  currency    String
  occurredAt  DateTime
  /// предположение, требует подтверждения
  guessedServiceId String?
  /// 0..1 — уверенность распознавания
  confidence       Float

  status                CandidateStatus @default(pending)
  resolvedAt            DateTime?
  createdSubscriptionId String?

  connection ImportConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([connectionId, status])
}

enum CandidateStatus {
  pending
  accepted
  /// отклонённый не предлагается повторно (FR-10)
  rejected
  duplicate
}

// ─────────────────────────────────────────────────────────
//  Справочники и служебное
// ─────────────────────────────────────────────────────────

/// Курсы ЦБ РФ, обновляются раз в сутки (FR-08)
model ExchangeRate {
  id String @id @default(cuid())

  currency String
  date     DateTime @db.Date
  /// курс к RUB в минорных единицах, 4 знака точности
  rateMinor Int
  source    String   @default("cbr")

  @@unique([currency, date])
  @@index([date])
}

/// Тарифные ограничения. Проверяются НА СЕРВЕРЕ (ADR-0005)
model FeatureFlag {
  id String @id @default(cuid())

  /// "import.bank", "analytics.full", "export.data"
  key          String  @unique
  requiredPlan Plan    @default(pro)
  isEnabled    Boolean @default(true)
  description  String?
}

/// Аудит изменений состояний подписок (NFR-03)
model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  /// "subscription.cancelled", "import.connected"
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
