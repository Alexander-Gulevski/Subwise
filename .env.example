# ─────────────────────────────────────────────────────────
#  Subwise — пример переменных окружения
#
#  Скопируй в .env и заполни. Файл .env в .gitignore и
#  НИКОГДА не коммитится (docs/06-security-privacy.md, T5).
# ─────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000

# ── База данных ──────────────────────────────────────────
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://subwise:PASSWORD@localhost:5432/subwise

# ── Redis: кэш, очереди, rate limiting ───────────────────
REDIS_URL=redis://localhost:6379

# ── Шифрование токенов внешних источников ────────────────
# AES-256-GCM. Ровно 32 байта в hex (64 символа).
# Сгенерировать:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ХРАНИТСЯ ТОЛЬКО ЗДЕСЬ. Никогда в БД — иначе утечка дампа раскроет токены.
ENCRYPTION_KEY=

# ── Секрет подписи сессий ────────────────────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Telegram ─────────────────────────────────────────────
# Токен бота от @BotFather. Используется и для проверки
# HMAC-подписи Telegram Login (ADR-0003).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет вебхука — произвольная строка, сверяется с заголовком
# X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# ── Почта для OTP ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Отписка <noreply@example.ru>"

# ── Защита служебных эндпоинтов ──────────────────────────
# Заголовок X-Cron-Secret для /api/cron/*
CRON_SECRET=

# ── Курсы валют ──────────────────────────────────────────
CBR_RATES_URL=https://www.cbr-xml-daily.ru/daily_json.js
